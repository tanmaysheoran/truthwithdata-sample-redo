./01_5https://truthwithdata.com/css/case-studies.css?v=1.11OV$/* Case studies: listing page, individual case studies, homepage section */
:root {
    --cs-ink: #0f172a;
    --cs-navy: #0b1530;
    --cs-navy-2: #13204a;
    --cs-line: #e2e8f0;
    --cs-soft: #f1f5f9;
    --cs-blue-soft: #eff6ff;
    --cs-amber: #d97706;
    --cs-amber-soft: #fffbeb;
    --cs-sky: #22b0e6; /* logo light blue */
}

/* ---------- Hero ---------- */
.cs-hero {
    position: relative;
    overflow: hidden;
    background:
        radial-gradient(1000px 420px at 85% -10%, rgba(34, 176, 230, 0.28), transparent 60%),
        radial-gradient(800px 380px at -10% 110%, rgba(37, 99, 235, 0.35), transparent 60%),
        linear-gradient(160deg, var(--cs-navy) 0%, var(--cs-navy-2) 100%);
    color: #e2e8f0;
    padding: 132px 20px 120px;
}

.cs-hero::after { /* faint chart grid */
    content: "";
    position: absolute;
    inset: 0;
    background-image:
        linear-gradient(rgba(148, 163, 184, 0.08) 1px, transparent 1px),
        linear-gradient(90deg, rgba(148, 163, 184, 0.08) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.9), transparent 85%);
    -webkit-mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.9), transparent 85%);
    pointer-events: none;
}

.cs-hero-inner {
    position: relative;
    z-index: 1;
    max-width: 1140px;
    margin: 0 auto;
}

.cs-crumbs {
    font-size: 0.9rem;
    color: #94a3b8;
    margin-bottom: 22px;
}

.cs-crumbs a { color: #cbd5e1; text-decoration: none; }
.cs-crumbs a:hover { color: #fff; text-decoration: underline; }

.cs-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--cs-sky);
    margin-bottom: 14px;
}

.cs-hero h1 {
    font-size: clamp(2rem, 4.6vw, 3.4rem);
    line-height: 1.08;
    font-weight: 800;
    color: #fff;
    letter-spacing: -0.02em;
    max-width: 900px;
}

.cs-dek {
    font-size: clamp(1.05rem, 1.7vw, 1.25rem);
    line-height: 1.6;
    color: #cbd5e1;
    max-width: 780px;
    margin-top: 18px;
}

.cs-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 26px;
}

.cs-chip {
    display: inline-block;
    padding: 6px 12px;
    border-radius: 999px;
    font-size: 0.82rem;
    font-weight: 600;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.16);
    color: #e2e8f0;
}

.cs-hero-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    margin-top: 22px;
    font-size: 0.88rem;
    color: #94a3b8;
}

.cs-hero-meta i { color: var(--cs-sky); margin-right: 6px; }

/* ---------- Metric tiles ---------- */
.cs-metrics {
    position: relative;
    z-index: 2;
    max-width: 1140px;
    margin: -72px auto 0;
    padding: 0 20px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
}

.cs-metric {
    background: #fff;
    border-radius: 14px;
    padding: 22px 22px 20px;
    box-shadow: 0 18px 40px -18px rgba(15, 23, 42, 0.35), 0 2px 6px rgba(15, 23, 42, 0.06);
    border-top: 4px solid var(--primary-color);
}

.cs-metric.is-warn { border-top-color: var(--cs-amber); }

.cs-metric-value {
    font-size: clamp(1.9rem, 3.4vw, 2.6rem);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--cs-ink);
    font-variant-numeric: tabular-nums;
}

.cs-metric-value small {
    font-size: 0.5em;
    font-weight: 700;
    color: var(--gray-color);
    margin-left: 2px;
}

.cs-metric-label {
    margin-top: 10px;
    font-size: 0.92rem;
    line-height: 1.45;
    color: var(--gray-color);
}

/* ---------- Layout ---------- */
.cs-layout {
    max-width: 1140px;
    margin: 0 auto;
    padding: 56px 20px 40px;
    display: grid;
    grid-template-columns: 280px minmax(0, 1fr);
    gap: 48px;
    align-items: start;
}

.cs-glance {
    position: sticky;
    top: 96px;
    background: var(--light-color);
    border: 1px solid var(--cs-line);
    border-radius: 14px;
    padding: 22px;
    font-size: 0.92rem;
}

.cs-glance h2 {
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gray-color);
    margin-bottom: 14px;
}

.cs-glance dl { margin: 0; }
.cs-glance dt { font-weight: 700; color: var(--cs-ink); margin-top: 14px; }
.cs-glance dt:first-child { margin-top: 0; }
.cs-glance dd { margin: 4px 0 0; color: var(--dark-color); line-height: 1.55; }
.cs-glance dd a { color: var(--primary-color); }

.cs-glance .cs-glance-cta {
    display: block;
    margin-top: 20px;
    text-align: center;
    padding: 11px 16px;
    font-size: 0.95rem;
}

.cs-toc { margin-top: 18px; padding-top: 16px; border-top: 1px solid var(--cs-line); }
.cs-toc a {
    display: block;
    padding: 5px 0;
    color: var(--gray-color);
    text-decoration: none;
    font-size: 0.9rem;
}
.cs-toc a:hover { color: var(--primary-color); }

.cs-body { min-width: 0; }

.cs-section { margin-bottom: 56px; scroll-margin-top: 96px; }

.cs-section > h2 {
    display: flex;
    align-items: baseline;
    gap: 14px;
    font-size: clamp(1.5rem, 2.4vw, 1.9rem);
    font-weight: 800;
    color: var(--cs-ink);
    letter-spacing: -0.01em;
    margin-bottom: 16px;
    line-height: 1.25;
}

.cs-num {
    font-size: 0.85rem;
    font-weight: 800;
    color: var(--primary-color);
    font-variant-numeric: tabular-nums;
    flex: none;
}

.cs-body p,
.cs-body li {
    font-size: 1.06rem;
    line-height: 1.78;
    color: #1e293b;
}

.cs-body p { margin-bottom: 16px; }
.cs-body ul, .cs-body ol { margin: 0 0 18px 22px; }
.cs-body li { margin-bottom: 8px; }
.cs-body a:not(.btn) { color: var(--primary-color); }
.cs-body strong { color: var(--cs-ink); }
.cs-body h3 { font-size: 1.2rem; color: var(--cs-ink); margin: 28px 0 10px; }

.cs-lede {
    font-size: 1.2rem !important;
    line-height: 1.7 !important;
    color: var(--cs-ink) !important;
}

/* Approach pipeline */
.cs-steps {
    list-style: none;
    margin: 24px 0 8px !important;
    padding: 0;
    counter-reset: step;
    position: relative;
}

.cs-steps::before {
    content: "";
    position: absolute;
    left: 21px;
    top: 10px;
    bottom: 10px;
    width: 2px;
    background: linear-gradient(var(--primary-color), var(--cs-sky));
    opacity: 0.35;
}

.cs-steps li {
    position: relative;
    padding: 0 0 22px 64px;
    margin: 0 !important;
}

.cs-steps li::before {
    counter-increment: step;
    content: counter(step);
    position: absolute;
    left: 0;
    top: 0;
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    font-weight: 800;
    color: #fff;
    background: linear-gradient(135deg, var(--primary-color), var(--cs-sky));
    box-shadow: 0 6px 16px -6px rgba(37, 99, 235, 0.6);
}

.cs-steps h3 { margin: 8px 0 4px !important; font-size: 1.08rem !important; }
.cs-steps p { margin: 0 !important; font-size: 1rem !important; color: #334155 !important; }

/* Figures */
.cs-figure {
    margin: 28px 0 32px;
    background: #fff;
    border: 1px solid var(--cs-line);
    border-radius: 14px;
    padding: 14px;
}

.cs-figure img {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 6px;
}

.cs-figure figcaption {
    margin-top: 10px;
    padding: 0 6px 4px;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--gray-color);
}

.cs-figure figcaption strong { color: var(--cs-ink); }

.cs-figure-scroll { overflow-x: auto; }
.cs-figure-scroll img { min-width: 640px; }

/* Insight / business / limits callouts */
.cs-callout {
    border-radius: 14px;
    padding: 22px 24px;
    margin: 24px 0;
    background: var(--cs-blue-soft);
    border: 1px solid #dbeafe;
}

.cs-callout h3 { margin-top: 0 !important; display: flex; gap: 10px; align-items: center; }
.cs-callout h3 i { color: var(--primary-color); }
.cs-callout p:last-child, .cs-callout ul:last-child { margin-bottom: 0; }

.cs-callout.is-limits { background: var(--cs-amber-soft); border-color: #fde68a; }
.cs-callout.is-limits h3 i { color: var(--cs-amber); }

.cs-takeaway {
    border-left: 4px solid var(--primary-color);
    padding: 4px 0 4px 18px;
    margin: 6px 0 22px;
    font-weight: 600;
    color: var(--cs-ink) !important;
}

/* Results table */
.cs-table-wrap { overflow-x: auto; margin: 18px 0 26px; border: 1px solid var(--cs-line); border-radius: 12px; }
.cs-table { width: 100%; border-collapse: collapse; font-size: 0.95rem; min-width: 560px; }
.cs-table th, .cs-table td { padding: 12px 14px; text-align: right; border-bottom: 1px solid var(--cs-line); }
.cs-table th:first-child, .cs-table td:first-child { text-align: left; }
.cs-table thead th { background: var(--light-color); font-size: 0.82rem; text-transform: uppercase; letter-spacing: 0.05em; color: var(--gray-color); }
.cs-table tbody tr:last-child td { border-bottom: 0; }
.cs-table td { font-variant-numeric: tabular-nums; }
.cs-table .is-best td { background: #f8fbff; font-weight: 700; }

/* Business value grid */
.cs-value-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin: 20px 0 8px;
}

.cs-value {
    border: 1px solid var(--cs-line);
    border-radius: 14px;
    padding: 20px;
    background: #fff;
}

.cs-value i { font-size: 1.2rem; color: var(--primary-color); }
.cs-value h3 { margin: 10px 0 6px !important; font-size: 1.05rem !important; }
.cs-value p { font-size: 0.98rem !important; margin: 0 !important; color: #334155 !important; }

/* Engagement timeline */
.cs-engage {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin: 20px 0 10px;
}

.cs-engage-step {
    position: relative;
    padding: 20px;
    border-radius: 14px;
    background: linear-gradient(180deg, #fff, var(--light-color));
    border: 1px solid var(--cs-line);
}

.cs-engage-step .cs-when {
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--primary-color);
}

.cs-engage-step h3 { margin: 6px 0 6px !important; font-size: 1.05rem !important; }
.cs-engage-step p { font-size: 0.96rem !important; margin: 0 !important; color: #334155 !important; }

/* Stack / deliverables */
.cs-stack { display: flex; flex-wrap: wrap; gap: 8px; margin: 10px 0 0; }
.cs-stack span {
    padding: 5px 11px;
    border-radius: 8px;
    background: var(--cs-soft);
    border: 1px solid var(--cs-line);
    font-size: 0.85rem;
    font-weight: 600;
    color: #334155;
}

.cs-links { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 18px; }
.cs-links .btn { padding: 11px 20px; font-size: 0.95rem; }
.cs-links .btn i { margin-right: 6px; }

/* Disclosure line */
.cs-disclosure {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    font-size: 0.92rem !important;
    color: var(--gray-color) !important;
    border-top: 1px solid var(--cs-line);
    padding-top: 18px;
    margin-top: 8px;
}

.cs-disclosure i { color: var(--gray-color); margin-top: 4px; }

/* ---------- Live demo (AI review detector) ---------- */
.cs-demo {
    margin: 26px 0 30px;
    border-radius: 18px;
    padding: 26px;
    background:
        radial-gradient(600px 240px at 100% 0, rgba(34, 176, 230, 0.18), transparent 60%),
        linear-gradient(160deg, var(--cs-navy), var(--cs-navy-2));
    color: #e2e8f0;
    box-shadow: 0 24px 48px -24px rgba(15, 23, 42, 0.55);
}

.cs-demo h3 { color: #fff !important; margin: 0 0 6px !important; display: flex; gap: 10px; align-items: center; }
.cs-demo h3 .cs-live {
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    padding: 3px 8px;
    border-radius: 999px;
    background: rgba(34, 197, 94, 0.18);
    color: #86efac;
    border: 1px solid rgba(134, 239, 172, 0.4);
}

.cs-demo p { color: #cbd5e1 !important; font-size: 0.98rem !important; }

.cs-demo label { display: block; font-weight: 600; color: #fff; margin: 14px 0 8px; font-size: 0.95rem; }

.cs-demo textarea {
    width: 100%;
    min-height: 110px;
    resize: vertical;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.06);
    color: #fff;
    padding: 14px;
    font-size: 1rem;
    line-height: 1.55;
}

.cs-demo textarea:focus { border-color: var(--cs-sky); box-shadow: 0 0 0 3px rgba(34, 176, 230, 0.25); }
.cs-demo textarea::placeholder { color: #94a3b8; }

.cs-demo-actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 12px; }

.cs-demo-actions button {
    border-radius: 10px;
    padding: 9px 14px;
    font-size: 0.9rem;
    font-weight: 600;
    cursor: pointer;
    font-family: inherit;
    border: 1px solid rgba(255, 255, 255, 0.22);
    background: rgba(255, 255, 255, 0.06);
    color: #e2e8f0;
}

.cs-demo-actions button:hover { background: rgba(255, 255, 255, 0.14); }

.cs-demo-out {
    margin-top: 20px;
    border-radius: 14px;
    padding: 18px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    min-height: 120px;
}

.cs-meter {
    position: relative;
    height: 14px;
    border-radius: 999px;
    background: linear-gradient(90deg, #64748b 0%, #94a3b8 50%, var(--cs-sky) 75%, #2563eb 100%);
    margin: 14px 0 6px;
}

.cs-meter-pin {
    position: absolute;
    top: 50%;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: #fff;
    border: 4px solid var(--cs-navy);
    box-shadow: 0 0 0 2px #fff;
    transform: translate(-50%, -50%);
    transition: left 0.45s cubic-bezier(0.4, 0, 0.2, 1);
}

.cs-meter-scale { display: flex; justify-content: space-between; font-size: 0.78rem; color: #94a3b8; }

.cs-verdict { font-size: 1.25rem; font-weight: 800; color: #fff; }
.cs-verdict small { display: block; font-size: 0.9rem; font-weight: 500; color: #cbd5e1; margin-top: 4px; }

.cs-why { margin-top: 14px; font-size: 0.9rem; color: #cbd5e1; }
.cs-why-chips { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
.cs-why-chips span { padding: 4px 9px; border-radius: 8px; font-size: 0.85rem; font-weight: 600; }
.cs-why-chips .to-ai { background: rgba(37, 99, 235, 0.3); color: #dbeafe; border: 1px solid rgba(96, 165, 250, 0.5); }
.cs-why-chips .to-human { background: rgba(148, 163, 184, 0.2); color: #e2e8f0; border: 1px solid rgba(148, 163, 184, 0.45); }

.cs-demo-note { font-size: 0.85rem !important; color: #94a3b8 !important; margin: 14px 0 0 !important; }

/* ---------- CTA band ---------- */
.cs-cta {
    background: linear-gradient(135deg, var(--primary-color), #1d4ed8 55%, var(--cs-navy-2));
    color: #fff;
    padding: 64px 20px;
}

.cs-cta-inner {
    max-width: 1140px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: 32px;
    align-items: center;
}

.cs-cta h2 { font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 800; line-height: 1.2; color: #fff; }
.cs-cta p { color: #dbeafe; font-size: 1.08rem; line-height: 1.65; margin-top: 12px; }
.cs-cta-actions { display: flex; flex-wrap: wrap; gap: 12px; justify-content: flex-end; }
.cs-cta .btn-light { background: #fff; color: var(--primary-color); box-shadow: var(--shadow-lg); }
.cs-cta .btn-light:hover { transform: translateY(-2px); }
.cs-cta .btn-ghost { border: 2px solid rgba(255, 255, 255, 0.6); color: #fff; background: transparent; }
.cs-cta .btn-ghost:hover { background: rgba(255, 255, 255, 0.12); }

/* ---------- More case studies ---------- */
.cs-more { max-width: 1140px; margin: 0 auto; padding: 56px 20px 72px; }
.cs-more h2 { font-size: 1.5rem; font-weight: 800; color: var(--cs-ink); margin-bottom: 20px; }

/* ---------- Cards (listing page + homepage) ---------- */
.cs-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
}

.cs-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid var(--cs-line);
    border-radius: 18px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: var(--transition-smooth);
    box-shadow: var(--shadow-sm);
}

.cs-card:hover { transform: translateY(-6px); box-shadow: var(--shadow-xl); border-color: #bfdbfe; }

.cs-card-top {
    position: relative;
    padding: 24px 24px 20px;
    background:
        radial-gradient(420px 160px at 100% 0, rgba(34, 176, 230, 0.28), transparent 60%),
        linear-gradient(150deg, var(--cs-navy), var(--cs-navy-2));
    color: #fff;
}

.cs-card-kicker {
    font-size: 0.74rem;
    font-weight: 800;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--cs-sky);
}

.cs-card-metric {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-top: 14px;
}

.cs-card-metric strong {
    white-space: nowrap;
    font-size: 2.6rem;
    line-height: 1;
    font-weight: 800;
    letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
}

.cs-card-metric span { font-size: 0.92rem; line-height: 1.4; color: #cbd5e1; }

.cs-card-body { padding: 22px 24px 24px; display: flex; flex-direction: column; flex: 1; }
.cs-card-body h3 { font-size: 1.3rem; line-height: 1.35; font-weight: 800; color: var(--cs-ink); }
.cs-card-body p { margin-top: 10px; color: var(--gray-color); line-height: 1.65; font-size: 0.98rem; }

.cs-card-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 16px; }
.cs-card-tags span {
    font-size: 0.78rem;
    font-weight: 600;
    padding: 4px 10px;
    border-radius: 999px;
    background: var(--cs-blue-soft);
    color: var(--primary-color);
}

.cs-card-link {
    margin-top: auto;
    padding-top: 18px;
    font-weight: 700;
    color: var(--primary-color);
}

.cs-card-link i { transition: transform 0.2s ease; margin-left: 6px; }
.cs-card:hover .cs-card-link i { transform: translateX(4px); }

/* ---------- Listing page extras ---------- */
.cs-index-hero { padding-bottom: 96px; }

.cs-proof {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
    margin-top: 34px;
    max-width: 920px;
}

.cs-proof div {
    border-left: 2px solid rgba(34, 176, 230, 0.6);
    padding: 4px 0 4px 14px;
}

.cs-proof strong { display: block; font-size: 1.7rem; font-weight: 800; color: #fff; line-height: 1.1; }
.cs-proof span { font-size: 0.88rem; color: #94a3b8; }

.cs-index-wrap { max-width: 1140px; margin: 0 auto; padding: 64px 20px 24px; }

.cs-capabilities {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
    margin-top: 20px;
}

.cs-capability {
    border: 1px solid var(--cs-line);
    border-radius: 14px;
    padding: 20px;
    background: #fff;
}

.cs-capability i {
    width: 40px;
    height: 40px;
    border-radius: 10px;
    display: grid;
    place-items: center;
    background: var(--cs-blue-soft);
    color: var(--primary-color);
    font-size: 1.05rem;
}

.cs-capability h3 { margin-top: 12px; font-size: 1.05rem; color: var(--cs-ink); }
.cs-capability p { margin-top: 6px; font-size: 0.95rem; color: var(--gray-color); line-height: 1.6; }
.cs-capability a { color: var(--primary-color); font-size: 0.9rem; font-weight: 600; }

.cs-h2 {
    font-size: clamp(1.6rem, 2.6vw, 2rem);
    font-weight: 800;
    color: var(--cs-ink);
    letter-spacing: -0.01em;
}

.cs-sub { color: var(--gray-color); font-size: 1.05rem; margin-top: 8px; max-width: 720px; line-height: 1.6; }

.cs-process {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin-top: 22px;
    counter-reset: proc;
}

.cs-process div {
    border-radius: 14px;
    padding: 20px;
    background: var(--light-color);
    border: 1px solid var(--cs-line);
}

.cs-process div::before {
    counter-increment: proc;
    content: "0" counter(proc);
    font-weight: 800;
    color: var(--primary-color);
    font-size: 0.9rem;
}

.cs-process h3 { margin-top: 8px; font-size: 1.02rem; color: var(--cs-ink); }
.cs-process p { margin-top: 6px; font-size: 0.94rem; color: var(--gray-color); line-height: 1.6; }

/* Homepage section */
.cs-home-note { text-align: center; color: var(--gray-color); font-size: 0.92rem; margin-top: 18px; }

/* ---------- Responsive ---------- */
@media (max-width: 1024px) {
    .cs-metrics { grid-template-columns: repeat(2, 1fr); }
    .cs-layout { grid-template-columns: minmax(0, 1fr); gap: 28px; }
    .cs-glance { position: static; }
    .cs-toc { display: none; }
    .cs-capabilities { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .cs-process { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}

@media (max-width: 768px) {
    .cs-hero { padding: 108px 16px 100px; }
    .cs-grid, .cs-value-grid, .cs-engage { grid-template-columns: minmax(0, 1fr); }
    .cs-cta-inner { grid-template-columns: minmax(0, 1fr); }
    .cs-cta-actions { justify-content: flex-start; }
    .cs-proof { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .cs-layout { padding: 40px 16px 24px; }
    .cs-metrics { padding: 0 16px; }
    .cs-index-wrap, .cs-more { padding-left: 16px; padding-right: 16px; }
}

@media (max-width: 520px) {
    .cs-metrics { grid-template-columns: minmax(0, 1fr); }
    .cs-capabilities, .cs-process { grid-template-columns: minmax(0, 1fr); }
    .cs-demo { padding: 18px; }
    .cs-card-metric strong { font-size: 2.2rem; }
}

@media (prefers-reduced-motion: reduce) {
    .cs-card, .cs-meter-pin { transition: none; }
}

/* Homepage band: dark "proof" section between the blog and services */
.cs-home {
    background:
        radial-gradient(900px 360px at 90% 0, rgba(34, 176, 230, 0.22), transparent 60%),
        linear-gradient(160deg, var(--cs-navy), var(--cs-navy-2));
}

.cs-home .section-title { color: #fff; }
.cs-home .section-subtitle { color: #cbd5e1; }
.cs-home .cs-card { border-color: rgba(255, 255, 255, 0.08); }
.cs-home .cs-card-top { background: linear-gradient(150deg, #13204a, #1e3a8a); }
.cs-home .cs-home-note { color: #94a3b8; }
.cs-home .btn-outline { color: #fff; border-color: rgba(255, 255, 255, 0.7); }
.cs-home .btn-outline:hover { background: #fff; color: var(--cs-ink); }
